{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "typeless-client",
  "version": "2.0.1",
  "identifier": "com.reverse-typeless.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "url": "index.html",
        "width": 340,
        "height": 580,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#1a1a1a",
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true,
        "center": false
      },
      {
        "label": "pill",
        "title": "",
        "url": "pill.html",
        "width": 280,
        "height": 72,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "focusable": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/libopuschunk.dll",
      "resources/libopuschunk.dylib"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
